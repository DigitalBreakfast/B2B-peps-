# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for production transactional email delivery via Resend.
# Configure this in your Vercel Project Settings under Environment Variables.
RESEND_API_KEY=

# CONTACT_TO_EMAIL: The inbox where incoming B2B procurement inquiries are delivered.
# Defaults to info@b2bpeps.com if left blank.
CONTACT_TO_EMAIL=info@b2bpeps.com

# CONTACT_FROM_EMAIL: The verified sender address on your custom domain in Resend.
# E.g. "B2B Peps Inquiries <inquiries@b2bpeps.com>" or "B2B Peps <notifications@b2bpeps.com>"
CONTACT_FROM_EMAIL=B2B Peps Inquiries <inquiries@b2bpeps.com>
